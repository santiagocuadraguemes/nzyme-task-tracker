# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# AWS SAM build artifacts
.aws-sam/

# Environment variables
.env

# Google OAuth credentials (legacy, pre-service-account)
credentials.json
token.json

# Google service account credentials (local dev only)
.secrets/

# Peer's standalone calendar project — not part of nzyme
calendar/
calendar.zip

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# Virtual environments
.venv/
venv/

# .venv / venv intentionally excluded — the virtual environment lives at the
# parent directory level and is shared across all workspace projects.

# Git worktrees
.worktrees/
.claude/worktrees/

# Local LLM call capture (NZYME_DEBUG_LLM / --dump-llm) — one JSONL per run
.llm_logs/

# Per-meeting --save-run history dumps (transcript_pipeline CLI)
runs/
# Corpus-level shadow-diff / candidate / baseline dumps
baseline.json
shadow-diff.json
cand-*.json

# Local debug artifacts (raw Notion payloads, preview dumps, ad-hoc SQL scratch)
_payload.json
_sql/
preview/
