# Required
NOTION_API_TOKEN=           # Notion integration token (secret_xxx)
MEETING_NOTES_DB_ID=        # Meeting Notes database ID
TEAM_TRACKER_DB_ID=         # Team Task Tracker database ID
SYSTEM_PROMPT_PAGE_ID=      # Notion page ID for AI system prompt
USER_PROMPT_PAGE_ID=        # Notion page ID for AI user prompt

# --- LLM keys: two-key split ---
# Light calls (classifier, fundraising summary, embeddings) → OpenAI
OPENAI_API_KEY=             # OpenAI API key
OPENAI_MODEL=gpt-5-mini     # Model for classifier + fundraising summary

# Heavy calls (transcript correction, task extraction) → Gemini via OpenAI-compat endpoint
GEMINI_API_KEY=             # Google Gemini API key
GEMINI_MODEL=gemini-3-flash-preview                                       # Gemini model for heavy calls
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  # rarely needs override

# Optional
BUFFER_HOURS=2              # Hours to wait after meeting date before processing
LOG_LEVEL=INFO
DRY_RUN=false
INCLUDE_AI_NOTES=false  # Include AI-generated meeting notes in extraction (true/false)
MEETING_TEMPLATE_PAGE_ID=  # Notion template page ID for meeting notes (optional, enables template injection)
INJECT_TEMPLATE=true       # Whether to inject the meeting note template into new pages (true/false)
WATCH_INTERVAL=10          # Seconds between template injection checks in --watch mode
SYNC_INTERVAL=300          # Seconds between sync runs in --watch mode (default 5 min)
LOGFIRE_TOKEN=             # Logfire write token (from https://logfire.pydantic.dev)

# Deal-aware extraction (optional — Investment Team)
DEAL_WORKPLANS_DB_ID=      # Deal Workplans database ID (enables deal context for AI extraction)

# Semantic dedup (optional)
SEMANTIC_DEDUP_THRESHOLD=0.85  # Cosine similarity threshold for embedding-based dedup (0.0-1.0)

# Transcript pipeline (optional)
TERMINOLOGY_DB_ID=         # Nzyme Terminology Dictionary DB ID (transcript correction)
ORG_CHART_DB_ID=           # Nzyme Org Chart DB ID (speaker identification)
CLASSIFIER_PROMPT_PAGE_ID= # Notion page ID for classifier prompt (transcript --write)

# Webhook / Lambda mode (optional)
WEBHOOK_PATH_TOKEN=        # Secret token in the API Gateway URL path for auth
IDLE_MINUTES=3             # Minutes of inactivity before AI extraction triggers
AWS_REGION=eu-west-1       # AWS region for Lambda deployment

# Google Calendar (service account + Domain-Wide Delegation; optional)
# Set ONE of GOOGLE_SERVICE_ACCOUNT_FILE (local dev) or GOOGLE_SERVICE_ACCOUNT_SECRET_ARN (Lambda).
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/service-account.json   # Local path to service-account.json
GOOGLE_SERVICE_ACCOUNT_SECRET_ARN=                          # Lambda: Secrets Manager ARN for the SA JSON
GCAL_DELEGATED_USER_DEFAULT=santiago@kiboventures.com       # Fallback Workspace email when page creator can't be resolved

# Fundraising → Affinity branch (optional; opt-in)
FUNDRAISING_BRANCH_ENABLED=false    # Enable Affinity sync for Meeting type = Fundraising
AFFINITY_API_KEY=                   # Affinity API key (settings → API → create new key)
AFFINITY_LP_FUNNEL_LIST_ID=168609   # List id for "Nzyme - LP Funnel"
KIBO_USER_MAP_PATH=                 # Override path to kibo_user_map.json (optional)

# Deprecated (retained for backward compat; unused by pipeline routing)
# OPENAI_BASE_URL=
